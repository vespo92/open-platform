# OAuth2-Proxy ForwardAuth Middleware for Traefik
#
# Protects services that don't have built-in auth (e.g., kubevirt-manager).
# Services with built-in Forgejo OAuth2 (headlamp, woodpecker, apps) don't need this.
#
# How it works:
#   1. Traefik calls /oauth2/start on the forwardAuth address
#   2. If user has a valid cookie → 202, request passes through
#   3. If not → 302 redirect to Forgejo login (oauth2-proxy reads X-Forwarded-*
#      headers via reverse_proxy=true to build the correct redirect-back URL)
#   4. After Forgejo login → callback sets cookie → redirects back to original URL
#
# Usage: add this annotation to any Ingress that needs protection:
#   traefik.ingress.kubernetes.io/router.middlewares: oauth2-proxy-oauth2-proxy-auth@kubernetescrd
#
# NOTE: The previous design used a Traefik "errors" middleware to catch 401s from
# /oauth2/auth and serve an HTML redirect page. This doesn't work because Traefik's
# errors middleware only intercepts backend service errors, NOT forwardAuth responses.
# Using /oauth2/start with reverse_proxy=true handles the redirect natively.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: oauth2-proxy-auth
  namespace: oauth2-proxy
spec:
  forwardAuth:
    address: http://oauth2-proxy.oauth2-proxy.svc:4180/oauth2/start
    trustForwardHeader: true
    authResponseHeaders:
      - X-Auth-Request-User
      - X-Auth-Request-Email
      - Set-Cookie
